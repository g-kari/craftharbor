{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "ignoreScripts": true,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Keep these updates manual until required real CI checks are enforced and verified.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "actions/checkout",
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": false
    },
    {
      "description": "Review pre-1.0 dependency changes explicitly.",
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Fail closed: keep every dependency manual until required real CI checks are enforced and verified.",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": false
  }
}
